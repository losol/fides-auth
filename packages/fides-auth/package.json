{
  "name": "@eventuras/fides-auth",
  "version": "0.16.0",
  "description": "Framework-agnostic OAuth/OIDC authentication library with PKCE, session management, and pluggable logging",
  "keywords": [
    "oauth",
    "oidc",
    "openid-connect",
    "authentication",
    "pkce",
    "session",
    "jwt",
    "identity",
    "vipps"
  ],
  "homepage": "https://github.com/losol/fides-auth/tree/main/packages/fides-auth#readme",
  "bugs": {
    "url": "https://github.com/losol/fides-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/fides-auth.git",
    "directory": "packages/fides-auth"
  },
  "license": "MIT",
  "author": "losol <losol@users.noreply.github.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session-events": {
      "types": "./dist/session-events.d.ts",
      "import": "./dist/session-events.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "import": "./dist/oidc.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./providers/vipps": {
      "types": "./dist/providers/vipps/index.d.ts",
      "import": "./dist/providers/vipps/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^6.2.14",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "workspace:*",
    "@eventuras/vite-config": "workspace:*",
    "@types/node": "^22.20.5",
    "jsdom": "30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
