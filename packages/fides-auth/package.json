{
  "name": "@eventuras/fides-auth",
  "version": "0.13.0",
  "description": "Framework-agnostic OAuth/OIDC authentication library with PKCE, session management, and pluggable logging",
  "keywords": [
    "oauth",
    "oidc",
    "openid-connect",
    "authentication",
    "pkce",
    "session",
    "jwt",
    "identity",
    "vipps"
  ],
  "homepage": "https://github.com/losol/fides-auth/tree/main/packages/fides-auth#readme",
  "bugs": {
    "url": "https://github.com/losol/fides-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/fides-auth.git",
    "directory": "packages/fides-auth"
  },
  "license": "MIT",
  "author": "losol <losol@users.noreply.github.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./activity-tracker": {
      "types": "./dist/activity-tracker.d.ts",
      "import": "./dist/activity-tracker.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "import": "./dist/cookies.js"
    },
    "./heartbeat": {
      "types": "./dist/heartbeat.d.ts",
      "import": "./dist/heartbeat.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./session-refresh": {
      "types": "./dist/session-refresh.d.ts",
      "import": "./dist/session-refresh.js"
    },
    "./session-validation": {
      "types": "./dist/session-validation.d.ts",
      "import": "./dist/session-validation.js"
    },
    "./session-cookies": {
      "types": "./dist/session-cookies.d.ts",
      "import": "./dist/session-cookies.js"
    },
    "./session-events": {
      "types": "./dist/session-events.d.ts",
      "import": "./dist/session-events.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./oauth-logging": {
      "types": "./dist/oauth-logging.d.ts",
      "import": "./dist/oauth-logging.js"
    },
    "./oauth-browser": {
      "types": "./dist/oauth-browser.d.ts",
      "import": "./dist/oauth-browser.js"
    },
    "./silent-login": {
      "types": "./dist/silent-login.d.ts",
      "import": "./dist/silent-login.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "import": "./dist/rate-limit.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./providers/vipps": {
      "types": "./dist/providers/vipps/index.d.ts",
      "import": "./dist/providers/vipps/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^6.2.8",
    "openid-client": "^6.8.3"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "workspace:*",
    "@eventuras/vite-config": "workspace:*",
    "@types/node": "^22.20.1",
    "jsdom": "29.1.1",
    "typescript": "^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
