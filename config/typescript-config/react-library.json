{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Library",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["react"],
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "${configDir}/dist"
  },
  "include": [
    "${configDir}/src/**/*"
  ]
}
